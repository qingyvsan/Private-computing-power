<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.computing-power.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/cp-agent/bin/cpstart</string>
        <string>--config</string>
        <string>/opt/cp-agent/configs/cpstart.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/cp-agent</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/opt/cp-agent/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/opt/cp-agent/logs/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>